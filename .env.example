# wolfmem configuration — copy to your shell profile or a .env loader.
# Nothing here is required; empty config = offline keyword mode.

# ---- data directory ----
# WOLFMEM_HOME=~/.wolfmem

# ---- embeddings (OpenAI-compatible /v1/embeddings) ----
# Without a key, recall falls back to CJK keyword matching.
# WOLFMEM_EMB_API=https://api.siliconflow.cn/v1/embeddings
# WOLFMEM_EMB_MODEL=BAAI/bge-m3
# WOLFMEM_EMB_KEY=

# ---- distiller LLM (OpenAI-compatible /v1/chat/completions) ----
# The observer sends journal text to this endpoint. Pick a provider you trust.
# WOLFMEM_LLM_API_BASE=https://your-llm.example/v1
# WOLFMEM_LLM_MODEL=glm-5.3-flash
# WOLFMEM_LLM_KEY=

# ---- recall tuning ----
# WOLFMEM_RECALL_TOP=4
# WOLFMEM_MIN_SCORE=0.42
# WOLFMEM_DEDUPE_SCORE=0.93
# WOLFMEM_MAX_FACTS=800

# ---- observer tuning ----
# WOLFMEM_OBSERVE_INTERVAL=3600
# WOLFMEM_OBSERVE_MIN_LINES=3
# WOLFMEM_OBSERVE_MAX_LINES=60

# ---- http ----
# WOLFMEM_HTTP_TIMEOUT=30
